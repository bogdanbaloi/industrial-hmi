# Treat most source text as auto-normalised.
* text=auto

# Console scenario fixtures must stay on LF so the exact-match diff in
# tests/scenarios/run-scenario.cmake behaves identically on Linux and
# Windows runners. A CRLF-converted checkout would silently break the
# comparison.
tests/scenarios/*.txt      text eol=lf
tests/scenarios/*.expected text eol=lf

# TLS test material (REQ-INTEGRATION-010) stays on LF: each certificate is
# checked against its key at load time, so a CRLF-converted checkout would
# be a needless source of platform-only test failures.
tests/fixtures/tls/*       text eol=lf

# OPC-UA security fixtures are DER, which is binary. Declared rather than
# left to content sniffing: a certificate mangled by EOL conversion does not
# fail at checkout, it fails at handshake time with an obscure error.
tests/fixtures/opcua-security/** binary

# gettext translation catalogs are canonical LF.
*.po                       text eol=lf
*.pot                      text eol=lf

# GtkBuilder XML and CSS — LF keeps diffs stable across platforms.
*.ui                       text eol=lf
*.css                      text eol=lf

# Shell scripts, CMake files — LF.
*.sh                       text eol=lf
*.cmake                    text eol=lf
CMakeLists.txt             text eol=lf

# Binary files — leave alone.
*.png                      binary
*.jpg                      binary
*.jpeg                     binary
*.mo                       binary
*.db                       binary
*.sqlite                   binary
